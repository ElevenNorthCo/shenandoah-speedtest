{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "shenandoahspeedtest.com"
        }
      ],
      "destination": "https://www.shenandoahspeedtest.com/:path*",
      "permanent": true
    }
  ]
}
